 /* ---- Turn: speech ---- */
 
+/* Local PC TTS returns 16 kHz mono PCM. The existing voice task consumes the
+ * stream concurrently; reply text and generated speech stay on the LAN. */
+static bool local_tts(msg_t &m, int index)
+{
+    if (!s_turn.texts || !muse_settings_speaker_on()) return false;
+    const char *text = s_turn.texts + index * TEXT_MAX;
+    size_t length = strnlen(text, TEXT_MAX);
+    if (!length || length >= TEXT_MAX) return false;
+    esp_http_client_config_t cfg = {};
+    cfg.url = "http://192.0.2.10:4215/speech";
+    cfg.method = HTTP_METHOD_POST;
+    cfg.timeout_ms = 30000;
+    esp_http_client_handle_t client = esp_http_client_init(&cfg);
+    if (!client) return false;
+    bool success = false;
+    size_t written = 0;
+    if (esp_http_client_open(client, (int)length) == ESP_OK &&
+        esp_http_client_write(client, text, (int)length) == (int)length) {
+        int64_t bytes = esp_http_client_fetch_headers(client);
+        if (bytes > 0 && bytes <= 16000 * 2 * 180 && esp_http_client_get_status_code(client) == 200) {
+            m.pcm_frames = (uint32_t)(bytes / 2);
+            uint8_t chunk[1024];
+            while (written < (size_t)bytes && s_turn.gen == s_gen.load()) {
+                int n = esp_http_client_read(client, (char *)chunk, sizeof(chunk));
+                if (n <= 0) break;
+                size_t at = 0;
+                while (at < (size_t)n && s_turn.gen == s_gen.load()) {
+                    size_t sent = xStreamBufferSend(s_out, chunk + at, n - at, pdMS_TO_TICKS(500));
+                    at += sent;
+                }
+                written += at;
+                s_turn.pcm_out += at / sizeof(int16_t);
+            }
+            success = written == (size_t)bytes;
+        }
+    }
+    esp_http_client_close(client);
+    esp_http_client_cleanup(client);
+    if (!success) ESP_LOGW(TAG, "local speech unavailable or interrupted");
+    return success || written > 0;
+}
+
 static void start_tts(void)
 {
     if (s_turn.tts_msg >= 0) {
@@ -1527,12 +1570,18 @@ static void start_tts(void)
          * and finishes the message once it's drained.
          */
         m.pcm_start = s_turn.pcm_out;
-        m.pcm_frames = (uint32_t)(m.len * MIC_RATE / TEXT_CHARS_PER_S);
         m.tts = TTS_ACTIVE;
         s_turn.tts_msg = i;
-        s_turn.silent = true;
         ESP_LOGI(TAG, "showing message %s (%u chars)", m.id, (unsigned)m.len);
         show_reply_start(m);
+        if (local_tts(m, i)) {
+            m.tts = TTS_FINISHED;
+            s_turn.tts_msg = -1;
+            s_turn.silent = false;
+        } else {
+            m.pcm_frames = (uint32_t)(m.len * MIC_RATE / TEXT_CHARS_PER_S);
+            s_turn.silent = true;
+        }
         return;
     }
 }
